{
  "schema_version": 1,
  "minecraft": "1.21.1",
  "units": "时间单位：1 秒 = 20 tick；1 游戏日 = 24000 tick = 现实 20 分钟。/effect 的时长是秒；/time、/title times、/schedule 的纯数字是 tick（time 类参数可以带后缀：30s = 30 秒，1d = 1 游戏日，100t = 100 tick）；/worldborder 的过渡时间是秒。伤害和血量按\"点\"算：1 颗心 = 2 点，玩家满血 20 点。",
  "general": [
    "改动之前先查当前值（/gamerule <规则>、/time query daytime、/difficulty、get_player 看位置/模式/效果），恢复时用得上。",
    "选择器别用裸 @e（会包含玩家）；清掉落物用 @e[type=minecraft:item]，加 distance=..N 限定范围。",
    "召唤的东西加标签方便收回：/summon … {Tags:[\"aiadmin\"]}，之后 /kill @e[tag=aiadmin]。",
    "不可逆的操作（kill、clear 整个背包、fill/setblock 覆盖方块、difficulty peaceful 清怪）做之前要确认是对方真正想要的。"
  ],
  "commands": {
    "time": {"summary": "查看/设置时间", "syntax": ["time set day|noon|night|midnight|<time>", "time add <time>", "time query daytime|gametime|day"],
             "units": "<time> 纯数字是 tick，可带 s/d/t 后缀；day=1000，noon=6000，night=13000，midnight=18000", "undo": "先 time query daytime 记下，再 time set <原值>", "risk": "低"},
    "weather": {"summary": "改天气", "syntax": ["weather clear|rain|thunder [<duration>]"],
                "units": "duration 是 time 类参数：纯数字按 tick，建议写成 600s 这样带单位；不填就是随机时长", "undo": "改回原来的天气（不确定原天气就 clear）", "risk": "低"},
    "effect": {"summary": "给/清除状态效果", "syntax": ["effect give <targets> <effect> [<seconds>|infinite] [<amplifier>] [<hideParticles>]", "effect clear <targets> [<effect>]"],
               "units": "时长单位是秒，默认 30 秒；amplifier 0 = I 级，1 = II 级；瞬间效果（instant_health / instant_damage）时长无意义", "undo": "effect clear <targets> <effect>", "risk": "低到中（负面效果别给太久）"},
    "give": {"summary": "给物品", "syntax": ["give <targets> <item>[<组件>] [<count>]"],
             "units": "count 是个数；1.21 物品组件写法：minecraft:diamond_sword[minecraft:enchantments={levels:{\"minecraft:sharpness\":5}}]", "undo": "clear <targets> <item> <count>", "risk": "中（普通玩家要物品需要授权）"},
    "clear": {"summary": "清除背包里的物品", "syntax": ["clear [<targets>] [<item>] [<maxCount>]"],
              "units": "不写 item = 清空整个背包（不可逆）；maxCount 0 = 只数不清", "undo": "清掉的物品无法恢复，只能按记录重新 give", "risk": "高（不写 item 会清空背包）"},
    "xp": {"summary": "经验（同 experience）", "syntax": ["xp add <targets> <amount> [points|levels]", "xp set <targets> <amount> [points|levels]", "xp query <target> points|levels"],
           "units": "不写单位时是经验点（points），等级要写 levels", "undo": "先 query，再 set 回原值或 add 负数", "risk": "中"},
    "experience": {"summary": "同 xp", "syntax": ["experience add|set|query …"], "units": "同 xp", "undo": "同 xp", "risk": "中"},
    "gamemode": {"summary": "切换游戏模式", "syntax": ["gamemode survival|creative|adventure|spectator [<target>]"],
                 "units": "", "undo": "先 get_player 看原模式，再切回", "risk": "中（给创造等于给任何物品）"},
    "gamerule": {"summary": "查看/设置游戏规则", "syntax": ["gamerule <rule>", "gamerule <rule> <value>"],
                 "units": "常用：keepInventory（死亡不掉落）、doDaylightCycle、doWeatherCycle、doMobSpawning、mobGriefing、doFireTick、playersSleepingPercentage（默认 100）、randomTickSpeed（默认 3）、doImmediateRespawn、naturalRegeneration",
                 "undo": "先 gamerule <rule> 查原值，再设回", "risk": "中（影响全服）"},
    "difficulty": {"summary": "查看/设置难度", "syntax": ["difficulty", "difficulty peaceful|easy|normal|hard"],
                   "units": "", "undo": "设回原难度；切到 peaceful 会立刻清除所有敌对生物（不可逆）", "risk": "中"},
    "tp": {"summary": "传送（同 teleport）", "syntax": ["tp <targets> <destination>", "tp <targets> <x> <y> <z> [<yaw> <pitch>]", "execute in minecraft:the_nether run tp <targets> <x> <y> <z>"],
           "units": "坐标可用 ~ 相对；跨维度要 execute in <维度> run tp", "undo": "先 get_player 记下原位置和维度，再 tp 回去", "risk": "中（别传进方块里或虚空）"},
    "teleport": {"summary": "同 tp", "syntax": ["teleport <targets> <destination|x y z>"], "units": "同 tp", "undo": "同 tp", "risk": "中"},
    "kill": {"summary": "杀死实体", "syntax": ["kill [<targets>]"],
             "units": "清掉落物：kill @e[type=minecraft:item,distance=..64]", "undo": "不可逆", "risk": "高（裸 @e 会杀玩家和所有生物）"},
    "summon": {"summary": "召唤实体", "syntax": ["summon <entity> [<pos>] [<nbt>]"],
               "units": "加 {Tags:[\"aiadmin\"]} 方便事后收回", "undo": "kill @e[tag=aiadmin]（或按类型和范围）", "risk": "中（数量别多，免得卡服）"},
    "setblock": {"summary": "放一个方块", "syntax": ["setblock <pos> <block> [destroy|keep|replace]"],
                 "units": "", "undo": "被覆盖的方块（含箱子内容）无法恢复", "risk": "高"},
    "fill": {"summary": "填充区域", "syntax": ["fill <from> <to> <block> [replace [<filter>]|destroy|keep|hollow|outline]"],
             "units": "一次最多 32768 个方块", "undo": "被覆盖的方块无法恢复", "risk": "高"},
    "clone": {"summary": "复制区域", "syntax": ["clone <begin> <end> <destination> [replace|masked] [force|move|normal]"], "units": "一次最多 32768 个方块", "undo": "目标处原有方块无法恢复", "risk": "高"},
    "spawnpoint": {"summary": "设置玩家重生点", "syntax": ["spawnpoint [<targets>] [<pos>] [<angle>]"], "units": "", "undo": "设回原重生点（get_player 里有）", "risk": "低"},
    "setworldspawn": {"summary": "设置世界出生点", "syntax": ["setworldspawn [<pos>] [<angle>]"], "units": "", "undo": "设回原值（get_world_info 里有）", "risk": "中"},
    "title": {"summary": "屏幕标题", "syntax": ["title <targets> title|subtitle|actionbar <JSON 文本>", "title <targets> times <fadeIn> <stay> <fadeOut>", "title <targets> clear|reset"],
              "units": "times 三个值都是 tick（20 = 1 秒）", "undo": "title <targets> clear", "risk": "低"},
    "tellraw": {"summary": "发 JSON 文本消息", "syntax": ["tellraw <targets> <JSON 文本>"], "units": "例：tellraw @a {\"text\":\"你好\",\"color\":\"gold\"}", "undo": "无（发出去就收不回）", "risk": "低"},
    "playsound": {"summary": "播放音效", "syntax": ["playsound <sound> <source> <targets> [<pos>] [<volume>] [<pitch>] [<minVolume>]"],
                  "units": "source：master、music、record、weather、block、hostile、neutral、player、ambient、voice；pitch 0.5–2", "undo": "stopsound <targets> [<source>] [<sound>]", "risk": "低"},
    "particle": {"summary": "粒子效果", "syntax": ["particle <name> [<pos>] [<delta>] [<speed>] [<count>] [force|normal] [<viewers>]"], "units": "count 别太大", "undo": "无（会自然消失）", "risk": "低"},
    "enchant": {"summary": "给手持物品附魔", "syntax": ["enchant <targets> <enchantment> [<level>]"], "units": "等级不能超过上限，且要和已有附魔兼容；超上限要用 give 带组件", "undo": "不能直接去掉附魔", "risk": "中"},
    "damage": {"summary": "造成伤害", "syntax": ["damage <target> <amount> [<damageType>] [at <pos> | by <entity> [from <cause>]]"], "units": "amount 是生命值点数（1 颗心 = 2）", "undo": "effect give <target> minecraft:instant_health", "risk": "中到高"},
    "worldborder": {"summary": "世界边界", "syntax": ["worldborder get", "worldborder set <distance> [<time>]", "worldborder add <distance> [<time>]", "worldborder center <pos>"],
                    "units": "distance 是边长（格）；time 是过渡秒数", "undo": "先 get 记原值再 set 回", "risk": "中"},
    "kick": {"summary": "踢出玩家", "syntax": ["kick <targets> [<reason>]"], "units": "", "undo": "玩家可以重新进服", "risk": "中"},
    "ban": {"summary": "封禁玩家", "syntax": ["ban <targets> [<reason>]"], "units": "", "undo": "pardon <name>", "risk": "高（一般要服主决定）"},
    "pardon": {"summary": "解封", "syntax": ["pardon <name>"], "units": "", "undo": "ban", "risk": "中"},
    "whitelist": {"summary": "白名单", "syntax": ["whitelist add|remove <name>", "whitelist on|off|list|reload"], "units": "", "undo": "add ↔ remove", "risk": "中"},
    "say": {"summary": "以后台身份全服说话", "syntax": ["say <message>"], "units": "机器人说话请用 send_chat", "undo": "无", "risk": "低"},
    "schedule": {"summary": "延时执行函数", "syntax": ["schedule function <function> <time> [append|replace]", "schedule clear <function>"], "units": "time 纯数字是 tick，可带 s/d/t", "undo": "schedule clear <function>", "risk": "中"},
    "locate": {"summary": "找最近的结构/群系/兴趣点（只读）", "syntax": ["locate structure <id|#tag>", "locate biome <id|#tag>", "locate poi <id|#tag>"],
               "units": "例：locate structure minecraft:village_plains、locate structure #minecraft:village", "undo": "只读", "risk": "低（大范围搜索可能卡一下）"},
    "spreadplayers": {"summary": "把玩家随机分散", "syntax": ["spreadplayers <center x z> <spreadDistance> <maxRange> [under <maxHeight>] <respectTeams> <targets>"], "units": "", "undo": "记下原位置再 tp 回", "risk": "中"},
    "attribute": {"summary": "查看/修改属性", "syntax": ["attribute <target> <attribute> get [<scale>]", "attribute <target> <attribute> base get|set <value>", "attribute <target> <attribute> modifier add|remove|value get …"],
                  "units": "例：minecraft:generic.scale（体型，默认 1.0）、minecraft:generic.movement_speed（玩家默认 0.1）、minecraft:generic.max_health（默认 20）", "undo": "先 base get 记原值再 base set 回", "risk": "中"},
    "ride": {"summary": "骑乘", "syntax": ["ride <target> mount <vehicle>", "ride <target> dismount"], "units": "", "undo": "ride <target> dismount", "risk": "低"},
    "item": {"summary": "改物品栏某一格", "syntax": ["item replace entity <target> <slot> with <item> [<count>]", "item replace block <pos> <slot> with <item> [<count>]"], "units": "slot 例：weapon.mainhand、armor.head、hotbar.0、container.5", "undo": "原来那格的物品会被覆盖、无法恢复", "risk": "高"},
    "data": {"summary": "读写 NBT", "syntax": ["data get entity|block|storage <target> [<path>]", "data merge entity|block <target> <nbt>"], "units": "data get 只读；玩家的数据不能用 data merge 修改", "undo": "先 get 记原值", "risk": "get 低 / merge 高"},
    "tag": {"summary": "实体标签", "syntax": ["tag <targets> add|remove <name>", "tag <targets> list"], "units": "", "undo": "add ↔ remove", "risk": "低"},
    "scoreboard": {"summary": "计分板", "syntax": ["scoreboard objectives add|remove|list|setdisplay …", "scoreboard players set|add|remove|get|reset <targets> <objective> [<score>]"], "units": "", "undo": "先 get 记原值", "risk": "低到中"},
    "advancement": {"summary": "给/撤销进度", "syntax": ["advancement grant|revoke <targets> only|everything|from|through|until <advancement>"], "units": "", "undo": "grant ↔ revoke", "risk": "中（会影响目标表判定）"},
    "recipe": {"summary": "解锁/锁上配方书条目", "syntax": ["recipe give|take <targets> <recipe>|*"], "units": "", "undo": "give ↔ take", "risk": "低"},
    "forceload": {"summary": "强制加载区块", "syntax": ["forceload add <from> [<to>]", "forceload remove <from> [<to>]", "forceload remove all", "forceload query"], "units": "坐标是方块坐标，按所在区块算", "undo": "forceload remove …", "risk": "中（加载太多会卡服）"},
    "tick": {"summary": "游戏速度", "syntax": ["tick query", "tick rate <rate>", "tick freeze|unfreeze", "tick step [<time>]", "tick sprint <time>"], "units": "rate 默认 20", "undo": "tick rate 20、tick unfreeze", "risk": "高（影响全服）"},
    "seed": {"summary": "世界种子（只读）", "syntax": ["seed"], "units": "", "undo": "只读", "risk": "低"},
    "list": {"summary": "在线玩家（只读）", "syntax": ["list [uuids]"], "units": "", "undo": "只读", "risk": "低"},
    "stopsound": {"summary": "停止音效", "syntax": ["stopsound <targets> [<source>] [<sound>]"], "units": "", "undo": "无", "risk": "低"},
    "team": {"summary": "队伍", "syntax": ["team add|remove|join|leave|modify|list …"], "units": "", "undo": "反向操作", "risk": "低到中"},
    "msg": {"summary": "私聊（同 tell / w）", "syntax": ["msg <targets> <message>"], "units": "机器人私聊玩家请用 send_chat 的 player", "undo": "无", "risk": "低"}
  }
}
